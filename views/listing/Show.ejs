<% layout('/layouts/boilerplate') %>
<script>
   const mapToken="<%= process.env.MAP_TOKEN%>";
   const coordinates=<%-JSON.stringify(listing.geometry.coordinates)%>;
</script>
  <div class="row">
    <div class="col-8 offset-2 mt-3">
      <h3><b>
          <%= listing.title %>
        </b></h3>
    </div>
    <div class="card col-6 offset-2 mt-3">
      <img src="<%= listing.image.url %>" class="show-img" alt="listing image" />
      <div class="card-body">
        <p>
          <i>Owned By: <%= listing.owner.username %></i><br>
          <%= listing.description %><br />
            &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "Price not available" %> <br />
              <%= listing.location %><br />
                <%= listing.country %>
        </p>
      </div>
    </div>
  </div>
  <% if(currUser&& listing.owner._id.equals(currUser._id)){ %>
    <div class="btns">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-2">Edit me</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button>Delete me!</button>
      </form>
    </div>
    <% } %>
      <hr />
      <div class="col-8 offset-2 mb-3 mt-3">
        <% if(currUser){ %>
          <h4 class="review">Leave a Review</h4>
          <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
            <div class="radio mt-3">
              <input id="rating-5" type="radio" name="review[rating]" value="5" />
              <label for="rating-5" title="5 stars">
                <svg viewBox="0 0 576 512" height="1em" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z">
                  </path>
                </svg>
              </label>

              <input id="rating-4" type="radio" name="review[rating]" value="4" />
              <label for="rating-4" title="4 stars">
                <svg viewBox="0 0 576 512" height="1em" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z">
                  </path>
                </svg>
              </label>

              <input id="rating-3" type="radio" name="review[rating]" value="3" />
              <label for="rating-3" title="3 stars">
                <svg viewBox="0 0 576 512" height="1em" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z">
                  </path>
                </svg>
              </label>

              <input id="rating-2" type="radio" name="review[rating]" value="2" />
              <label for="rating-2" title="2 stars">
                <svg viewBox="0 0 576 512" height="1em" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z">
                  </path>
                </svg>
              </label>

              <input id="rating-1" type="radio" name="review[rating]" value="1" />
              <label for="rating-1" title="1 star">
                <svg viewBox="0 0 576 512" height="1em" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z">
                  </path>
                </svg>
              </label>
            </div>

            <div class="mb-3 mt-3">
              <label for="comment" class="for-label">Comments</label>
              <textarea name="review[comment]" required class="form-control" id="comment" cols="30" rows="5"></textarea>
              <div class="invalid-feedback">Please submit some comments for Review</div>
              <br />
              <button>Submit</button>
            </div>
          </form>
          <hr>
          <% } %>
          <% if(listing.reviews.length>0){ %>
            <div class="row">
              <h4>All Reviews</h4>
              <% for(review of listing.reviews){ %>
                <div class="review-card col-5 ms-3 mb-3">
                  <div class="stars">
                    <% for(let i=1; i <=5; i++) { %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                        class="star <%= i <= review.rating ? 'text-warning' : 'text-secondary' %>" fill="currentColor"
                        style="width: 20px; height: 20px;">
                        <path
                          d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z">
                        </path>
                      </svg>
                      <% } %>
                        <span class="ms-1 fw-bold">(<%= review.rating %> Stars)</span>
                  </div>
                  <div class="infos mt-2">
                    <p class="description">
                      <%= review.comment %>
                    </p>
                  </div>
                  <div class="author">
                    @ <%= review.author.username %>
                  </div>
                  <form class="mb-3" method="POST"
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="mt-2">Delete</button>
                  </form>
                </div>
                <% } %>
            </div>
          <% } %>  
      </div>
        <div class="col-8 offset-2 mb-3">
          <h3>Where you'll be</h3>
          <div id="map"></div>
        </div>
<script src="/js/map.js"></script>